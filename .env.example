# ==============================================================================
# TRUSTLENS Deepfake Backend - Environment Variables
# ==============================================================================

# Server Network Configuration
PORT=8001
CORS_ORIGINS=*

# Device Selection: 'cpu' for standard laptops, 'cuda' if NVIDIA GPU available
DEVICE=cpu

# Pretrained Hugging Face Audio Deepfake Model
# Options:
#   'garystafford/wav2vec2-deepfake-voice-detector' (Default: fine-tuned on voice clones & ASVspoof)
#   'Bgeorge/deepfake-audio-detector-wav2vec2'
HF_AUDIO_MODEL_ID=garystafford/wav2vec2-deepfake-voice-detector
MODEL_CACHE_DIR=./model_cache

# Upload Safeguards & Resource Limits
MAX_FILE_SIZE_BYTES=26214400
MAX_AUDIO_DURATION_SECONDS=300.0
MIN_AUDIO_DURATION_SECONDS=0.5

# Classification Decision Thresholds
SYNTHETIC_RISK_THRESHOLD=0.65
AUTHENTIC_RISK_THRESHOLD=0.35
MIN_CONFIDENCE_THRESHOLD=0.60
